{
  "$defs": {
    "AudioMetrics": {
      "properties": {
        "agent_customer_talk_ratio": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Customer Talk Ratio"
        },
        "agent_talk_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Talk Ratio"
        },
        "agent_words_per_minute": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Words Per Minute"
        },
        "customer_talk_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Customer Talk Ratio"
        },
        "customer_words_per_minute": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Customer Words Per Minute"
        },
        "duration_s": {
          "minimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "filler_count": {
          "default": 0,
          "minimum": 0,
          "title": "Filler Count",
          "type": "integer"
        },
        "filler_rate_agent": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filler Rate Agent"
        },
        "filler_rate_customer": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filler Rate Customer"
        },
        "interruptions_unavailable_reason": {
          "default": "Transcript segments are sequential; overlapping speech is not measurable in v1.",
          "title": "Interruptions Unavailable Reason",
          "type": "string"
        },
        "longest_monologue_end_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longest Monologue End S"
        },
        "longest_monologue_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longest Monologue S"
        },
        "longest_monologue_start_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longest Monologue Start S"
        },
        "longest_monologue_turn_ids": {
          "items": {
            "type": "string"
          },
          "title": "Longest Monologue Turn Ids",
          "type": "array"
        },
        "overlap_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overlap Ratio"
        },
        "response_delay_median_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Delay Median S"
        },
        "response_delay_p90_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Delay P90 S"
        },
        "silence_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Silence Ratio"
        },
        "timeline_flags": {
          "items": {
            "$ref": "#/$defs/TimelineFlag"
          },
          "title": "Timeline Flags",
          "type": "array"
        },
        "timing_resolution": {
          "default": "segment_interpolated",
          "enum": [
            "segment_interpolated",
            "word"
          ],
          "title": "Timing Resolution",
          "type": "string"
        }
      },
      "required": [
        "duration_s"
      ],
      "title": "AudioMetrics",
      "type": "object"
    },
    "Coaching": {
      "properties": {
        "strength": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strength"
        },
        "top_fixes": {
          "items": {
            "$ref": "#/$defs/CoachingItem"
          },
          "maxItems": 3,
          "title": "Top Fixes",
          "type": "array"
        }
      },
      "title": "Coaching",
      "type": "object"
    },
    "CoachingItem": {
      "properties": {
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "finding_id": {
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "practice_drill": {
          "minLength": 1,
          "title": "Practice Drill",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "explanation",
        "practice_drill"
      ],
      "title": "CoachingItem",
      "type": "object"
    },
    "Commitment": {
      "properties": {
        "due": {
          "minLength": 1,
          "title": "Due",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "party": {
          "minLength": 1,
          "title": "Party",
          "type": "string"
        },
        "what": {
          "minLength": 1,
          "title": "What",
          "type": "string"
        }
      },
      "required": [
        "party",
        "what",
        "due",
        "evidence"
      ],
      "title": "Commitment",
      "type": "object"
    },
    "CustomerSignals": {
      "properties": {
        "buying_signals": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Buying Signals",
          "type": "array"
        },
        "commitments": {
          "items": {
            "$ref": "#/$defs/Commitment"
          },
          "title": "Commitments",
          "type": "array"
        },
        "objections": {
          "items": {
            "$ref": "#/$defs/Objection"
          },
          "title": "Objections",
          "type": "array"
        },
        "outcome": {
          "default": "unclear",
          "enum": [
            "advanced",
            "stalled",
            "lost",
            "unclear"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "sentiment_arc": {
          "items": {
            "$ref": "#/$defs/SentimentPoint"
          },
          "maxItems": 12,
          "title": "Sentiment Arc",
          "type": "array"
        },
        "unanswered_questions": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Unanswered Questions",
          "type": "array"
        }
      },
      "title": "CustomerSignals",
      "type": "object"
    },
    "DebugReport": {
      "properties": {
        "dropped_findings": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Dropped Findings",
          "type": "array"
        },
        "retrieved_passage_ids": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Retrieved Passage Ids",
          "type": "object"
        }
      },
      "title": "DebugReport",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "attempt": {
          "maximum": 2,
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "match_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Match Score",
          "type": "number"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "role": {
          "enum": [
            "agent",
            "customer",
            "other"
          ],
          "title": "Role",
          "type": "string"
        },
        "speaker": {
          "minLength": 1,
          "title": "Speaker",
          "type": "string"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "turn_id": {
          "pattern": "^T\\d{3,}$",
          "title": "Turn Id",
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "speaker",
        "role",
        "quote",
        "start_s",
        "end_s",
        "match_score",
        "attempt"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "MissedMoment": {
      "properties": {
        "better_alternative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Better Alternative"
        },
        "category": {
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "confidence": {
          "default": "medium",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "grounded": {
          "default": false,
          "title": "Grounded",
          "type": "boolean"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "model_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Model Confidence",
          "type": "number"
        },
        "playbook_refs": {
          "items": {
            "$ref": "#/$defs/PlaybookRef"
          },
          "title": "Playbook Refs",
          "type": "array"
        },
        "rubric_item_id": {
          "minLength": 1,
          "title": "Rubric Item Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "what_happened": {
          "minLength": 1,
          "title": "What Happened",
          "type": "string"
        },
        "why_it_hurt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Why It Hurt"
        }
      },
      "required": [
        "id",
        "rubric_item_id",
        "category",
        "model_confidence",
        "what_happened",
        "severity"
      ],
      "title": "MissedMoment",
      "type": "object"
    },
    "NextSteps": {
      "properties": {
        "follow_up_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Follow Up Message"
        },
        "recommended_actions": {
          "items": {
            "type": "string"
          },
          "title": "Recommended Actions",
          "type": "array"
        }
      },
      "title": "NextSteps",
      "type": "object"
    },
    "Objection": {
      "properties": {
        "raised_evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "resolution_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolved": {
          "title": "Resolved",
          "type": "boolean"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "raised_evidence",
        "resolved"
      ],
      "title": "Objection",
      "type": "object"
    },
    "PlaybookRef": {
      "properties": {
        "book_title": {
          "minLength": 1,
          "title": "Book Title",
          "type": "string"
        },
        "chapter": {
          "minLength": 1,
          "title": "Chapter",
          "type": "string"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "page_end": {
          "minimum": 1,
          "title": "Page End",
          "type": "integer"
        },
        "page_start": {
          "minimum": 1,
          "title": "Page Start",
          "type": "integer"
        },
        "passage_id": {
          "minLength": 1,
          "title": "Passage Id",
          "type": "string"
        }
      },
      "required": [
        "passage_id",
        "book_title",
        "chapter",
        "page_start",
        "page_end",
        "excerpt"
      ],
      "title": "PlaybookRef",
      "type": "object"
    },
    "ReportMeta": {
      "properties": {
        "audio_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Sha256"
        },
        "duration_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration S"
        },
        "models": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Models",
          "type": "object"
        },
        "pipeline_version": {
          "minLength": 1,
          "title": "Pipeline Version",
          "type": "string"
        },
        "playbook_identity": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Playbook Identity"
        },
        "prompt_ids": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Prompt Ids",
          "type": "object"
        },
        "rubric_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubric Id"
        },
        "rubric_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubric Version"
        },
        "stage_latency_s": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Stage Latency S",
          "type": "object"
        },
        "usage": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ]
          },
          "title": "Usage",
          "type": "object"
        }
      },
      "required": [
        "pipeline_version"
      ],
      "title": "ReportMeta",
      "type": "object"
    },
    "RubricResult": {
      "properties": {
        "category": {
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "confidence": {
          "default": "medium",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "model_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Model Confidence",
          "type": "number"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "rubric_item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubric Item Id"
        },
        "status": {
          "enum": [
            "met",
            "partial",
            "missed",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "category",
        "model_confidence",
        "status",
        "rationale"
      ],
      "title": "RubricResult",
      "type": "object"
    },
    "Scorecard": {
      "properties": {
        "category_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Category Scores",
          "type": "object"
        },
        "critical_failures": {
          "items": {
            "type": "string"
          },
          "title": "Critical Failures",
          "type": "array"
        },
        "overall_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overall Score"
        }
      },
      "title": "Scorecard",
      "type": "object"
    },
    "SentimentPoint": {
      "properties": {
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "sentiment": {
          "enum": [
            "positive",
            "neutral",
            "negative",
            "mixed"
          ],
          "title": "Sentiment",
          "type": "string"
        },
        "turn_id": {
          "pattern": "^T\\d{3,}$",
          "title": "Turn Id",
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "quote",
        "sentiment"
      ],
      "title": "SentimentPoint",
      "type": "object"
    },
    "TimelineFlag": {
      "properties": {
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "kind": {
          "enum": [
            "dead_air",
            "overlap",
            "fast_pace",
            "filler_cluster",
            "slow_response",
            "long_monologue"
          ],
          "title": "Kind",
          "type": "string"
        },
        "speaker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "start_s",
        "end_s",
        "detail"
      ],
      "title": "TimelineFlag",
      "type": "object"
    },
    "Transcript": {
      "properties": {
        "duration_s": {
          "minimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "language": {
          "default": "en",
          "title": "Language",
          "type": "string"
        },
        "source_model": {
          "default": "unknown",
          "title": "Source Model",
          "type": "string"
        },
        "speaker_roles": {
          "additionalProperties": {
            "enum": [
              "agent",
              "customer",
              "other"
            ],
            "type": "string"
          },
          "title": "Speaker Roles",
          "type": "object"
        },
        "speakers": {
          "items": {
            "type": "string"
          },
          "title": "Speakers",
          "type": "array"
        },
        "timing": {
          "default": "segment_interpolated",
          "enum": [
            "segment_interpolated",
            "word"
          ],
          "title": "Timing",
          "type": "string"
        },
        "turns": {
          "items": {
            "$ref": "#/$defs/Turn"
          },
          "title": "Turns",
          "type": "array"
        }
      },
      "required": [
        "duration_s"
      ],
      "title": "Transcript",
      "type": "object"
    },
    "Turn": {
      "properties": {
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "id": {
          "pattern": "^T\\d{3,}$",
          "title": "Id",
          "type": "string"
        },
        "role": {
          "default": "other",
          "enum": [
            "agent",
            "customer",
            "other"
          ],
          "title": "Role",
          "type": "string"
        },
        "speaker": {
          "minLength": 1,
          "title": "Speaker",
          "type": "string"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "words": {
          "items": {
            "$ref": "#/$defs/Word"
          },
          "minItems": 1,
          "title": "Words",
          "type": "array"
        }
      },
      "required": [
        "start_s",
        "end_s",
        "id",
        "speaker",
        "text",
        "words"
      ],
      "title": "Turn",
      "type": "object"
    },
    "Word": {
      "properties": {
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "speaker": {
          "minLength": 1,
          "title": "Speaker",
          "type": "string"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
