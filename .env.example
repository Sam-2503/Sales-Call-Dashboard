# Copy to .env and override only what you need. Values below mirror Settings defaults.
# Never commit a real API key.

# Required for live Gemini calls.
GEMINI_API_KEY=

# Models and LLM call policy.
CHAT_PROVIDER=google_genai
ANALYSIS_MODEL=gemini-2.5-pro
FAST_MODEL=gemini-2.5-flash
TRANSCRIBE_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
LLM_MAX_CONCURRENCY=4
LLM_MAX_RETRIES=2
LLM_TIMEOUT_S=60

# Audio ingestion and transcription.
MAX_AUDIO_MINUTES=5
MAX_AUDIO_BYTES=100000000
MIN_DURATION_S=60
MIN_WORDS=150
TRANSCRIBE_INLINE_MAX_MB=15
TRANSCRIBE_MAX_OUTPUT_TOKENS=16384
ROLE_PROBE_SECONDS=90
TURN_GAP_S=1.5
FAKE_MODE=false
WORK_DIR=data/work

# Deterministic conversation and audio metrics.
MONOLOGUE_GAP_S=2.0
LONG_MONOLOGUE_S=30.0
DEAD_AIR_S=3.0
SLOW_RESPONSE_S=2.5
SILENCE_DB=-40.0

# Evidence verification, repair, and confidence buckets.
VERIFY_TURN_RADIUS=1
VERIFY_MIN_SCORE=90
REPAIR_MAX_ATTEMPTS=2
CONFIDENCE_HIGH_MIN_MATCH_SCORE=97
CONFIDENCE_MEDIUM_MIN_MATCH_SCORE=93
CONFIDENCE_HIGH_MIN_MODEL_CONFIDENCE=0.7
CONFIDENCE_LOW_MAX_MODEL_CONFIDENCE=0.4

# Findings, selection, and grounding.
MAX_MISSED_MOMENTS=10
MAX_EXCERPT_WORDS=25
PLAYBOOK_GROUNDING=on

# Playbook extraction, indexing, and retrieval.
CHROMA_PATH=data/chroma
EMBEDDING_MANIFEST_NAME=playbook_manifest.json
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=60
TOKEN_ESTIMATE_FACTOR=1.3
PLAYBOOK_MAX_EMPTY_PAGE_RATIO=0.2
EMBEDDING_DIM=768
EMBED_BATCH_SIZE=32
EMBED_MAX_CONCURRENCY=4
QUERY_EMBED_CACHE_SIZE=256
PLAYBOOK_TOP_K=4
PLAYBOOK_MIN_SCORE=0.0

# Usage accounting, logging, and run provenance.
PRICING_PATH=config/pricing.yaml
LOG_LEVEL=INFO
LOG_TRANSCRIPTS=false
PIPELINE_VERSION=0.1.0
PROMPT_VERSIONS={}
