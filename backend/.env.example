# Copy to .env and override only what you need. Never commit a real secret.
# The backend also constructs call_analyser.Settings, so package tunables such as
# FAKE_MODE, MAX_AUDIO_MINUTES, MIN_DURATION_S and PLAYBOOK_GROUNDING are read
# from this same environment/.env.

# Runtime and edge behaviour.
ENVIRONMENT=dev
LOG_LEVEL=INFO
REQUEST_TIMEOUT_S=30
CORS_ORIGINS=[]
TRUSTED_PROXY_COUNT=1
# STATIC_DIR=

# Database. Use the pooled host for the API and the direct host for migrations.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# DATABASE_URL_DIRECT=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_POOLER=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_RETRIES=3

# Authentication. Generate at least 32 random characters outside dev.
JWT_SECRET=
JWT_TTL_DAYS=30
MEDIA_TOKEN_TTL_S=600
WORKSPACE_RATE_LIMIT_PER_HOUR=20
UPLOAD_RATE_LIMIT_PER_HOUR=30

# Daily quotas, spend control, and retention.
DAILY_CALLS_PER_WORKSPACE=5
DAILY_CALLS_GLOBAL=100
DAILY_BUDGET_USD=1.00
MAX_UPLOAD_MB=25
MAX_REANALYSES_PER_CALL=3
ALLOWED_AUDIO_EXTENSIONS=["wav","mp3","m4a","ogg","flac","webm"]
DEMO_WORKSPACES_PER_IP_PER_DAY=3
DEMO_SEED_CALLS=8
TRENDS_MIN_CALLS=3
RETENTION_DAYS=30
WORKSPACE_IDLE_DAYS=60
DEMO_IDLE_DAYS=3
JANITOR_INTERVAL_S=3600

# Audio storage. Local is the default; S3 works with any compatible endpoint.
STORAGE_BACKEND=local
STORAGE_DIR=data/audio
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# PLAYBOOK_ARTIFACT_PREFIX=

# Worker and progress streaming. Stage 4 wires these to the worker loop.
WORKER_ENABLED=false
WORKER_MODE=thread
WORKER_POLL_INTERVAL_S=2
WORKER_HEARTBEAT_INTERVAL_S=15
WORKER_STALE_AFTER_S=60
WORKER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=2
JOB_STALE_S=60
JOB_HEARTBEAT_S=10
SHUTDOWN_GRACE_S=20
SSE_POLL_S=0.7
SSE_KEEPALIVE_S=15

# Analysis integration. The package owns these values and validates audio limits.
RUBRIC_PATH=../rubrics/sales_v1.yaml
# PLAYBOOK_PATH=../playbooks/book.pdf
FAKE_MODE=false
MAX_AUDIO_MINUTES=5
MIN_DURATION_S=60
PLAYBOOK_GROUNDING=on
CHROMA_PATH=data/chroma

# Operator-only endpoints. Leave unset to disable them.
# ADMIN_TOKEN=
