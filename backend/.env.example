# Minimal production template.
# Copy this file to .env and fill the placeholder values.
# Keep this file and your real .env out of git history with real secrets.

# Runtime
ENVIRONMENT=prod

# Neon Postgres. Copy the connection string from Neon with pooling enabled.
# DATABASE_URL_DIRECT is optional; if omitted, migrations use DATABASE_URL.
DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<db>?sslmode=require&channel_binding=require
# DATABASE_URL_DIRECT=postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require
DB_POOLER=true

# Auth (32+ random chars, example: `openssl rand -base64 48`)
JWT_SECRET=<replace-with-long-random-secret>

# xAI/Grok provider
XAI_API_KEY=<replace-with-xai-api-key>
FAKE_MODE=false

# Audio storage (required for deployment; use private S3-compatible bucket)
STORAGE_BACKEND=s3
S3_BUCKET=call-recordings
# Copy these three values from Neon Object Storage's .env tab.
AWS_REGION=<your-neon-region>
AWS_ACCESS_KEY_ID=<your-neon-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-neon-secret-access-key>

# Keep off unless you have a real indexed playbook artifact configured.
PLAYBOOK_GROUNDING=off

# Optional: enable admin endpoints
# ADMIN_TOKEN=<optional-admin-token>
